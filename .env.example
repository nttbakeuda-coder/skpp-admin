# ── Konfigurasi Supabase ──────────────────────────────────────────────
# Salin file ini menjadi ".env.local" untuk mengarahkan DEV LOKAL ke
# project Supabase STAGING (uji fitur pengajuan online tanpa menyentuh
# produksi). ".env.local" TIDAK di-commit (sudah di-.gitignore via *.local).
#
# Tanpa .env.local, aplikasi memakai fallback = Supabase PRODUKSI (lihat
# src/supabaseClient.js) -> perilaku sekarang tidak berubah.
#
# Ambil nilai dari: Supabase Dashboard (project staging) ->
#   Settings -> API -> Project URL & Project API keys (publishable/anon).

VITE_SUPABASE_URL=https://<ref-staging>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-atau-publishable-key-staging>
